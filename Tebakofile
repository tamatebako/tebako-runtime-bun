# Feedstock recipe for bun
# spec 13 §9 + docs/conventions.md in tebako-packages/index
name: "bun"
kind: runtime
summary: "Bun (oven-sh prebuilt distributions) — tebako bun RUNTIME pairs (wrapper exe + env image); the hermetic javascript/typescript engine with in-process TS transpile"

# The spec 28 §8 implementation axis: ONE recipe, flavored sources. bun
# ships a single implementation today — oven-sh's official build — so
# `official` is the default (and only) flavor. The x64 artifacts are the
# BASELINE builds (no AVX requirement) for universal reach; a `modern`
# x64 variant is a possible later flavor on this same axis.
flavors:
  official:
    implementation: "bun"
    language_version: "1.4"          # the bun language line (major.minor; bun rolls weekly on 1.x — exact pins only, never `latest`)
    abi_line: "1.4"                  # the runtime's own line today; bun speaks NAPI with its own support matrix — the native-addon ABI grammar is pinned by the factory dogfood and documented in the README
    interpreter_api_version: "1.4"   # layout.yaml's required declared line
    # The simplest spawn surface in the ecosystem: bun is ONE
    # self-contained binary. `bunx` is the package-runner alias (bun x);
    # the image declares it as a second entrypoint — the alias mechanism
    # (hardlink vs declaration) is whichever the image grammar already
    # supports, decided at build, never a new mechanism.
    entrypoints: [bun, bunx]
    upstream:
      # Bun 1.4.2 (oven-sh/bun GitHub releases) — one binary source per
      # platform (repack: no compilation). platform is the spec 03
      # triplet; the zips nest under one dir (strip_components: 1).
      # Digests verified against the release's SHASUMS256.txt 2026-09-26
      # (the two linux-musl rows 2026-10-07 — issue #2's legs, landed as
      # declared recipe rows, never discovered at run time; the
      # aarch64-windows-ucrt row 2026-10-21). The x64 musl
      # row is the BASELINE build like its gnu sibling. Upstream's musl
      # binary is musl-DYNAMIC (DT_NEEDED libc.musl + libstdc++.so.6), so
      # the musl legs' smokes ride the alpine container (build-payload.yml).
      # Upstream signs the macOS/windows binaries (Oven); staging
      # verifies and records the verdict in the manifest's provenance.
      version: "1.4.3"
      sources:
        - platform: "aarch64-macos"
          url: "https://github.com/oven-sh/bun/releases/download/bun-v1.4.3/bun-darwin-aarch64.zip"
          sha256: "80afd4c069b46a6fa8f3ec520bebc750a7843e4a8d5b9583d29ad436c00a3403"
          strip_components: 1
        - platform: "x86_64-macos"
          url: "https://github.com/oven-sh/bun/releases/download/bun-v1.4.3/bun-darwin-x64-baseline.zip"
          sha256: "0fde04e8b092156b97fe6432e899baf16d9ed6ce52cbb4218d2d9c07a2f827ef"
          strip_components: 1
        - platform: "x86_64-linux-gnu"
          url: "https://github.com/oven-sh/bun/releases/download/bun-v1.4.3/bun-linux-x64-baseline.zip"
          sha256: "1fc2edac843102909e3a1be1d8d9802cc6071cf074e67e88231f4ffe0f8b397b"
          strip_components: 1
        - platform: "aarch64-linux-gnu"
          url: "https://github.com/oven-sh/bun/releases/download/bun-v1.4.3/bun-linux-aarch64.zip"
          sha256: "efa9813da5ed72423bf847f916e8d2c47c0d776add972354026a75e10da9aa21"
          strip_components: 1
        - platform: "x86_64-linux-musl"
          url: "https://github.com/oven-sh/bun/releases/download/bun-v1.4.3/bun-linux-x64-musl-baseline.zip"
          sha256: "4b5b0b5503f6ebf15161e8c56eb5a263134c05cd98a86dc11ee43ac5bda9862e"
          strip_components: 1
        - platform: "aarch64-linux-musl"
          url: "https://github.com/oven-sh/bun/releases/download/bun-v1.4.3/bun-linux-aarch64-musl.zip"
          sha256: "8de8a0003cc2707bb555887e3d450e24e1edf3f605f491393e89ed61a8853420"
          strip_components: 1
        - platform: "x86_64-windows-ucrt"
          url: "https://github.com/oven-sh/bun/releases/download/bun-v1.4.3/bun-windows-x64-baseline.zip"
          sha256: "d7a7d3eb216614544aab0cde2d8d9f2e4e87839bf5a30a1cd11d077f02d84e0c"
          strip_components: 1
        # aarch64-windows-ucrt (upstream native since v1.3.10; the tebako
        # product ships tebako-runtime-launcher for windows-ucrt-arm64 since
        # v2.8.16, pinned below at the v2.8.47 line). Upstream ships ONE
        # aarch64 windows build — no -baseline axis (that spelling is the
        # x64 no-AVX variant; the arch's only build is the row below).
        # Payloads needing `bun:ffi` exclude this triplet in any case — ffi
        # is disabled on the target upstream (oven-sh/bun#28055).
        - platform: "aarch64-windows-ucrt"
          url: "https://github.com/oven-sh/bun/releases/download/bun-v1.4.3/bun-windows-aarch64.zip"
          sha256: "5e8f142ef722cbc9f67dc068a166e46ee72be8307b38cac7186589d2face668f"
          strip_components: 1

build:
  system: repack          # no compilation: unpack, prune, image
  deps: []

# The runtime contract (spec 28 revised §8 + spec 29). tools/build renders
# manifests/runtime.yaml (tier-1, embedded at /__tpkg__/manifest.yaml) and
# manifests/layout.yaml (the driver pair contract, /lib/tebako/layout.yaml)
# from this block + the selected flavor's block — the feedstock's SSOT for
# the pair's declared identity.
runtime:
  engine: "bun"
  contract_version: 2              # the spec 17 driver contract the wrapper speaks
  interpreter: "/bin/bun"          # POSIX legs: the staged tree's bin/bun
  interpreter_windows: "/bun.exe"  # the windows zip stages bun.exe at the payload root
  # visibility key ABSENT in the rendered layout (spec 29 §3's locked
  # default order): preload on POSIX, exec-cache on windows — journaled
  # at boot, never a silent fallback.
  mount_root_override: false       # closed default — bun is one self-contained binary with no home tree to relocate; granting a no-op knob violates spec 00 §9
  # The tebako product line the pair builds against: the wrapper exe
  # (tebako-runtime-launcher) and the preload shim (link-unit). The line
  # number names the artifacts (tebako-runtime-2.8.22-bun-1.4.2-* since
  # tebako#716 — the flavor's implementation segment) and the
  # release tag (v2.8.22 — the trr convention: the tag IS the tebako
  # line).
  #
  # v2.8.22 (2026-09-28) is the current product line and the first pin of
  # this factory: it carries every contract the pair speaks — spec 29's
  # wrapper pattern, spec 32's executable requires edges, spec 33's
  # on_runtime composition, the mount-ancestor routes the flavors
  # mechanism mounts through, and the full linux-musl toolchain (the
  # musl legs' pins — issue #2).
  wrapper_tebako: "2.8.50"
  # The wrapper's trust anchor, per tool-platform (the launcher is the
  # shipped runtime pair's process entry point — an unauthenticated
  # download would be a supply-chain hole). Digests are the v2.8.22
  # release's monolith SHA256SUMS entries, fetched 2026-09-29 (the
  # linux-musl pair 2026-10-07; the windows-ucrt-arm64 entry 2026-10-21).
  wrapper_sha256:
    macos-arm64: "7dd80f329b8933acadc0b8a1cac7a1a0eaa92989df67deb6d44961c1cb1caad3"
    macos-x86_64: "b29cbf69298cb698232224f5ba1872ea94c9dbf3c48715b4131d7c3b1f2888b3"
    linux-gnu-x86_64: "848391491f776242abf9e4ac6d7334cd9e689a245e19467cf5289ea44beffa53"
    linux-gnu-arm64: "f393602190d0614582ca2875ea21ebeabc6908aa16b3d1b45fa4cb901a7212cc"
    linux-musl-x86_64: "1db0d2d266e637f29cfde9bc4f05a9bcf904dff0586887270230d834a6459fdc"
    linux-musl-arm64: "0666faf59c7e7971f07efe388a62cb0b912e323b4e75c971d0d75df57215ef69"
    windows-ucrt64: "6c9fd2acae243ed11d6e6750658b449f90ab7eb7162756e226b099270131bdd3"
    windows-ucrt-arm64: "275925074d0864b825c5133b02508212fb272aedb7668f23a2f30186a9be5da7"

# Factory tools used by tools/build (the imager + the preload shim): the
# tfs CLI and the link-unit tarball from the tamatebako/tebako release.
# The asset digests are pinned HERE — tools.sha256 is the repo's
# toolchain pin SSOT (the workflow carries no version or digest literals;
# tools/pins.rb reads this block into $GITHUB_ENV). The tfs pins are
# cross-checked against the release's SHA256SUMS at fetch time; the
# link-unit tarballs are NOT in that monolith, so these pins are their
# single trust anchor (verified against the v2.8.22 downloads 2026-09-29;
# the linux-musl pair 2026-10-07; the windows-ucrt-arm64 tfs 2026-10-21).
tools:
  repo: "tamatebako/tebako"
  release: "v2.8.50"
  # The release machinery pin: the tamatebako/tebako-release-tooling tag
  # the Gemfile resolves (the sign step's tebako-release exe). The gem is
  # the signer's single owner (ecosystem invariant 10) — this feedstock
  # carries no copy of it.
  #
  # v0.5.1: tebako#716's dual-era package-name grammar (on the v0.5.0
  # seam; v0.5.1 is the publish-leg convergence hardening on top). This
  # feedstock's sign pass is adapter-less and composes no names
  # (SIGN_ONLY_STEMS flows pins.rb's stem), so the bump is transparent —
  # it keeps the tooling line on the gem every sibling factory pins.
  release_tooling: "v0.5.1"
